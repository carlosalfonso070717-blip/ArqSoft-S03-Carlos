@model Catalogo.Presentation.Models.ReviewViewModel
@{
    ViewData["Title"] = "Agregar Reseña";
}

<div class="form-page">
    <div class="form-header">
        <h1>AGREGAR RESEÑA</h1>
        <p>Comparte tu opinión sobre <strong>@Model.ItemTitulo</strong></p>
    </div>

    <div class="form-container">
        <form asp-action="AgregarReview" method="post" class="game-form">
            <input type="hidden" asp-for="ItemId" />
            <input type="hidden" asp-for="ItemTitulo" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label class="form-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                        <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                    </svg>
                    Calificación (1-5 estrellas)
                </label>
                <div class="star-rating-input">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="star-label">
                            <input type="radio" asp-for="Estrellas" value="@i" id="star@(i)" />
                            <span class="star" data-rating="@i">⭐</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Estrellas" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Comentario" class="form-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-left-text" viewBox="0 0 16 16">
                        <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                        <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6m0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
                    </svg>
                    Tu Comentario
                </label>
                <textarea asp-for="Comentario" class="form-control" rows="5" 
                          placeholder="Comparte tu experiencia con este juego (mínimo 10 caracteres)..."></textarea>
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-hero-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
                    </svg>
                    Publicar Reseña
                </button>
                <a asp-action="Detalle" asp-route-id="@Model.ItemId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.star-label input[type="radio"]').forEach((radio, index) => {
            radio.addEventListener('change', function() {
                const stars = document.querySelectorAll('.star');
                stars.forEach((star, i) => {
                    if (i <= index) {
                        star.style.opacity = '1';
                        star.style.transform = 'scale(1.2)';
                    } else {
                        star.style.opacity = '0.3';
                        star.style.transform = 'scale(1)';
                    }
                });
            });
        });
    </script>
}

<style>
    .star-rating-input {
        display: flex;
        gap: 10px;
        margin: 10px 0;
    }

    .star-label {
        cursor: pointer;
        position: relative;
    }

    .star-label input[type="radio"] {
        position: absolute;
        opacity: 0;
    }

    .star {
        font-size: 2rem;
        opacity: 0.3;
        transition: all 0.2s ease;
    }

    .star-label:hover .star {
        opacity: 1;
        transform: scale(1.2);
    }

    .star-label input[type="radio"]:checked ~ .star {
        opacity: 1;
    }
</style>
