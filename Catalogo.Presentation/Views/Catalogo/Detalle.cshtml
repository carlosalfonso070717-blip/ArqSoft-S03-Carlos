@model CatalogoApp.Domain.Models.Item

<div class="detail-page">
    <div class="detail-header">
        <a asp-action="Index" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
            Volver al Catálogo
        </a>
    </div>

    <div class="detail-card">
        <div class="detail-layout">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div class="detail-image-container">
                    <img src="@Model.ImagenUrl" alt="@Model.Titulo" class="detail-image" />
                </div>
            }

            <div class="detail-content">
                <div class="detail-title-section">
                    <h1 class="detail-title">@Model.Titulo</h1>
                    <span class="detail-year">@Model.Ano</span>
                </div>

                @if (Model.TotalReviews > 0)
                {
                    <div class="rating-summary">
                        <div class="rating-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.PromedioEstrellas))
                                {
                                    <span class="star filled">⭐</span>
                                }
                                else
                                {
                                    <span class="star">☆</span>
                                }
                            }
                        </div>
                        <span class="rating-text">@Model.PromedioEstrellas.ToString("0.0") / 5.0 (@Model.TotalReviews @(Model.TotalReviews == 1 ? "reseña" : "reseñas"))</span>
                    </div>
                }

                <div class="detail-metadata">
                    <div class="metadata-item">
                        <div class="metadata-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-tag-fill" viewBox="0 0 16 16">
                                <path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.586-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1zm4 3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                            </svg>
                        </div>
                        <div class="metadata-content">
                            <div class="metadata-label">Género</div>
                            <div class="metadata-value">@Model.Genero</div>
                        </div>
                    </div>

                    <div class="metadata-item">
                        <div class="metadata-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-tv-fill" viewBox="0 0 16 16">
                                <path d="M2.5 13.5A.5.5 0 0 1 3 13h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5M2 2h12s2 0 2 2v6s0 2-2 2H2s-2 0-2-2V4s0-2 2-2"/>
                            </svg>
                        </div>
                        <div class="metadata-content">
                            <div class="metadata-label">Consola</div>
                            <div class="metadata-value">@Model.Consola</div>
                        </div>
                    </div>

                    <div class="metadata-item">
                        <div class="metadata-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-calendar-event-fill" viewBox="0 0 16 16">
                                <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v1h16V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4zM16 14V5H0v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2m-3.5-7h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5"/>
                            </svg>
                        </div>
                        <div class="metadata-content">
                            <div class="metadata-label">Año de Lanzamiento</div>
                            <div class="metadata-value">@Model.Ano</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <div class="detail-description">
                        <h3 class="description-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                            </svg>
                            Descripción
                        </h3>
                        <p class="description-text">@Model.Descripcion</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sección de Reviews -->
    <div class="reviews-section">
        <div class="reviews-header">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-chat-square-text" viewBox="0 0 16 16">
                    <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5a1 1 0 0 1 .8.4l1.9 2.533a1 1 0 0 0 1.6 0l1.9-2.533a1 1 0 0 1 .8-.4H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                    <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6m0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
                </svg>
                Reseñas de Usuarios
            </h2>
            @if (ViewBag.IsLoggedIn)
            {
                <a asp-action="AgregarReview" asp-route-itemId="@Model.Id" class="btn btn-add-review">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                    </svg>
                    Agregar Reseña
                </a>
            }
            else
            {
                <a asp-action="Login" asp-controller="Account" class="btn btn-add-review">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-in-right" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                        <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                    </svg>
                    Inicia sesión para reseñar
                </a>
            }
        </div>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            <div class="reviews-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-user">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                </svg>
                                <span class="username">@review.Username</span>
                            </div>
                            <div class="review-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Estrellas)
                                    {
                                        <span class="star filled">⭐</span>
                                    }
                                    else
                                    {
                                        <span class="star">☆</span>
                                    }
                                }
                            </div>
                        </div>
                        <p class="review-comment">@review.Comentario</p>
                        <div class="review-date">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
                                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                            </svg>
                            @review.FechaReview.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-reviews">
                <div class="no-reviews-icon">💬</div>
                <h3>Aún no hay reseñas</h3>
                <p>Sé el primero en compartir tu opinión sobre este juego</p>
            </div>
        }
    </div>
</div>

<style>
    /* Contenedor principal de la página de detalles */
    .detail-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 30px;
    }

    /* Header con botón de volver */
    .detail-header {
        margin-bottom: 30px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: white;
        color: #dc2626;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .btn-back:hover {
        background: #dc2626;
        color: white;
        transform: translateX(-5px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }

    /* Tarjeta principal del juego */
    .detail-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .detail-layout {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 40px;
        padding: 40px;
    }

    /* Contenedor de imagen */
    .detail-image-container {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .detail-image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
    }

    .detail-image-container:hover .detail-image {
        transform: scale(1.05);
    }

    /* Contenido del juego */
    .detail-content {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .detail-title-section {
        display: flex;
        align-items: baseline;
        gap: 15px;
        margin-bottom: 10px;
    }

    .detail-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1f2937;
        margin: 0;
        line-height: 1.2;
    }

    .detail-year {
        font-size: 1.3rem;
        color: #6b7280;
        font-weight: 600;
    }

    /* Metadata items */
    .detail-metadata {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .metadata-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: #f9fafb;
        border-radius: 10px;
        border-left: 4px solid #dc2626;
    }

    .metadata-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, #dc2626, #991b1b);
        border-radius: 10px;
        color: white;
        flex-shrink: 0;
    }

    .metadata-content {
        flex: 1;
    }

    .metadata-label {
        font-size: 0.875rem;
        color: #6b7280;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .metadata-value {
        font-size: 1.1rem;
        color: #1f2937;
        font-weight: 700;
    }

    /* Descripción */
    .detail-description {
        margin-top: 10px;
        padding: 25px;
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.05), rgba(153, 27, 27, 0.05));
        border-radius: 12px;
        border: 2px solid rgba(220, 38, 38, 0.1);
    }

    .description-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.3rem;
        font-weight: 700;
        color: #dc2626;
        margin-bottom: 15px;
    }

    .description-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: #4b5563;
        margin: 0;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .detail-layout {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 30px;
        }

        .detail-image-container {
            max-width: 500px;
            margin: 0 auto;
        }

        .detail-title {
            font-size: 2rem;
        }
    }

    @@media (max-width: 768px) {
        .detail-page {
            padding: 15px;
        }

        .detail-layout {
            padding: 20px;
        }

        .detail-title {
            font-size: 1.75rem;
        }

        .metadata-item {
            flex-direction: column;
            text-align: center;
        }
    }

    .rating-summary {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 15px 0;
        padding: 15px;
        background: rgba(220, 38, 38, 0.1);
        border-radius: 10px;
    }

    .rating-stars {
        display: flex;
        gap: 5px;
    }

    .rating-stars .star {
        font-size: 1.5rem;
    }

    .rating-stars .star.filled {
        color: #fbbf24;
    }

    .rating-text {
        font-size: 1.1rem;
        font-weight: 600;
        color: #dc2626;
    }

    .reviews-section {
        max-width: 1200px;
        margin: 40px auto 0;
        padding: 40px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .reviews-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f3f4f6;
    }

    .reviews-header h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #1f2937;
    }

    .btn-add-review {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: #dc2626;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-add-review:hover {
        background: #b91c1c;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }

    .reviews-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .review-card {
        padding: 20px;
        background: #f9fafb;
        border-radius: 10px;
        border-left: 4px solid #dc2626;
    }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .review-user {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #374151;
        font-weight: 600;
    }

    .review-stars {
        display: flex;
        gap: 3px;
    }

    .review-stars .star {
        font-size: 1.2rem;
    }

    .review-stars .star.filled {
        color: #fbbf24;
    }

    .review-comment {
        color: #4b5563;
        line-height: 1.6;
        margin-bottom: 10px;
    }

    .review-date {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.875rem;
        color: #9ca3af;
    }

    .no-reviews {
        text-align: center;
        padding: 60px 20px;
    }

    .no-reviews-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .no-reviews h3 {
        color: #374151;
        margin-bottom: 10px;
    }

    .no-reviews p {
        color: #6b7280;
    }
</style>