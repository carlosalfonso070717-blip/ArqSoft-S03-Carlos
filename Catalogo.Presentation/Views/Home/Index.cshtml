@{
    ViewData["Title"] = "Inicio";
}

<div class="home-page">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">🎮 Bienvenido a Mi Catálogo de Videojuegos</h1>
            <p class="hero-subtitle">Organiza, descubre y comparte tu colección de videojuegos favoritos</p>
            <div class="hero-actions">
                <a asp-controller="Catalogo" asp-action="Index" class="btn btn-hero-primary ripple-button rainbow-hover" data-tooltip="Explora todos los videojuegos">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-collection-fill" viewBox="0 0 16 16">
                        <path d="M0 13a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 16 13V6a1.5 1.5 0 0 0-1.5-1.5h-13A1.5 1.5 0 0 0 0 6zM2 3a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 0-1h-11A.5.5 0 0 0 2 3m2-2a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 0-1h-7A.5.5 0 0 0 4 1"/>
                    </svg>
                    Explorar Catálogo
                </a>
                @if (Context.Session.GetString("Username") == null)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-hero-secondary ripple-button rainbow-hover" data-tooltip="Únete a la comunidad">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
                            <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                            <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5"/>
                        </svg>
                        Crear Cuenta
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="features-section">
        <h2 class="section-title">¿Qué puedes hacer?</h2>
        <div class="features-grid">
            <div class="feature-card parallax-layer neon-border">
                <div class="feature-icon float-element">📚</div>
                <h3>Organiza tu Colección</h3>
                <p>Crea y gestiona tu biblioteca personal de videojuegos con toda la información importante</p>
            </div>

            <div class="feature-card parallax-layer neon-border">
                <div class="feature-icon float-element">⭐</div>
                <h3>Califica y Reseña</h3>
                <p>Comparte tu opinión con la comunidad mediante reseñas y calificaciones de 1 a 5 estrellas</p>
            </div>

            <div class="feature-card parallax-layer neon-border">
                <div class="feature-icon float-element">🔍</div>
                <h3>Descubre Nuevos Juegos</h3>
                <p>Explora reseñas de otros usuarios y encuentra tu próximo juego favorito</p>
            </div>

            <div class="feature-card parallax-layer neon-border">
                <div class="feature-icon float-element">🎯</div>
                <h3>Filtra por Género</h3>
                <p>Encuentra rápidamente juegos por género, consola y más opciones de búsqueda</p>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="stats-section">
        <h2 class="section-title">Nuestra Comunidad</h2>
        <div class="stats-grid">
            <div class="stat-card pulse-badge">
                <div class="stat-number">1000</div>
                <div class="stat-label">Videojuegos Catalogados</div>
            </div>
            <div class="stat-card pulse-badge">
                <div class="stat-number">500</div>
                <div class="stat-label">Usuarios Activos</div>
            </div>
            <div class="stat-card pulse-badge">
                <div class="stat-number">5000</div>
                <div class="stat-label">Reseñas Publicadas</div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section">
        <h2>¿Listo para comenzar?</h2>
        <p>Únete a nuestra comunidad y comienza a organizar tu colección de videojuegos hoy mismo</p>
        @if (Context.Session.GetString("Username") == null)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-cta">
                Regístrate Gratis
            </a>
        }
        else
        {
            <a asp-controller="Catalogo" asp-action="Agregar" class="btn btn-cta">
                Agregar tu Primer Juego
            </a>
        }
    </div>
</div>

<style>
    .home-page {
        width: 100%;
    }

    .hero-section {
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.95) 0%, rgba(153, 27, 27, 0.95) 100%);
        color: white;
        padding: 100px 30px;
        text-align: center;
        margin: -20px -15px 60px -15px;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h100v100H0z" fill="none"/><path d="M50 0L100 50L50 100L0 50z" fill="rgba(255,255,255,0.03)"/></svg>');
        opacity: 0.5;
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 25px;
        text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.4);
        letter-spacing: -1px;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: 1.4rem;
        margin-bottom: 45px;
        opacity: 0.95;
        font-weight: 300;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    .hero-actions {
        display: flex;
        gap: 25px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 40px;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 18px 40px;
        font-size: 1.15rem;
        font-weight: 700;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        border: none;
    }

    .btn-hero-primary {
        background: white;
        color: #dc2626;
    }

    .btn-hero-primary:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        color: #991b1b;
        background: #f9fafb;
    }

    .btn-hero-secondary {
        background: white;
        color: #dc2626;
    }

    .btn-hero-secondary:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        color: #991b1b;
        background: #f9fafb;
    }

    .section-title {
        text-align: center;
        font-size: 2.8rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 60px;
        position: relative;
        padding-bottom: 20px;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #dc2626, #f59e0b);
        border-radius: 2px;
    }

    .features-section {
        padding: 80px 30px;
        max-width: 1400px;
        margin: 0 auto 60px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 40px;
        padding: 0 20px;
    }

    .feature-card {
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        text-align: center;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid transparent;
        position: relative;
    }

    .feature-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #dc2626, #f59e0b);
        border-radius: 20px 20px 0 0;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .feature-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 15px 50px rgba(220, 38, 38, 0.25);
        border-color: rgba(220, 38, 38, 0.2);
    }

    .feature-card:hover::before {
        opacity: 1;
    }

    .feature-icon {
        font-size: 4.5rem;
        margin-bottom: 25px;
        display: inline-block;
        transition: transform 0.3s;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.15) rotate(5deg);
    }

    .feature-card h3 {
        color: #dc2626;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .feature-card p {
        color: #6b7280;
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .stats-section {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.95) 0%, rgba(17, 24, 39, 0.95) 100%);
        padding: 80px 30px;
        margin: 60px -15px;
        position: relative;
        overflow: hidden;
    }

    .stats-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg width="60" height="60" xmlns="http://www.w3.org/2000/svg"><circle cx="30" cy="30" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
        opacity: 0.3;
    }

    .stats-section .section-title {
        color: white;
    }

    .stats-section .section-title::after {
        background: linear-gradient(90deg, #f59e0b, #10b981);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 50px;
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .stat-card {
        text-align: center;
        padding: 30px 20px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s;
    }

    .stat-card:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
    }

    .stat-number {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #dc2626, #f59e0b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 15px;
    }

    .stat-label {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
    }

    .cta-section {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.98) 0%, rgba(17, 24, 39, 0.98) 100%);
        color: white;
        padding: 100px 30px;
        text-align: center;
        margin: 80px -15px -20px -15px;
        position: relative;
        overflow: hidden;
    }

    .cta-section::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(220, 38, 38, 0.1) 0%, transparent 70%);
        animation: float 10s ease-in-out infinite;
    }

    .cta-section h2 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 25px;
        position: relative;
        z-index: 1;
    }

    .cta-section p {
        font-size: 1.3rem;
        margin-bottom: 40px;
        opacity: 0.9;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        position: relative;
        z-index: 1;
        line-height: 1.6;
    }

    .btn-cta {
        display: inline-block;
        padding: 20px 50px;
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
        color: white;
        font-size: 1.25rem;
        font-weight: 700;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 8px 30px rgba(220, 38, 38, 0.4);
        position: relative;
        z-index: 1;
    }

    .btn-cta:hover {
        background: linear-gradient(135deg, #991b1b 0%, #7f1d1d 100%);
        transform: translateY(-5px);
        box-shadow: 0 12px 40px rgba(220, 38, 38, 0.6);
        color: white;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.15rem;
        }

        .section-title {
            font-size: 2.2rem;
        }

        .features-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .stat-number {
            font-size: 3rem;
        }

        .features-section,
        .stats-section,
        .cta-section {
            padding: 60px 20px;
        }

        .hero-section {
            padding: 80px 20px;
        }
    }
</style>
